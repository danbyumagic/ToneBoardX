<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="#DDDDDD" android:padding="5dp"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.android.com/apk/res/android ">

    <!-- This TextView will display your Pinyin/Chinese suggestions -->
    <TextView android:id="@+id/candidate_word" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#000000"
        android:padding="10dp" android:gravity="center_vertical"
        android:text="Suggestions will appear here" />

</LinearLayout>
